# Copy this file to .env and fill in values before starting the panel.

# Admin credentials (used on first run to seed the database)
ADMIN_USER=ahanox
ADMIN_PASS=13790

# JWT secrets — change both to long random strings in production!
JWT_SECRET=change_this_to_a_long_random_secret
JWT_REFRESH_SECRET=change_this_to_another_long_random_secret

# Backend port (default: 4000)
PORT=4000
