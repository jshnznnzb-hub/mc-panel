# /etc/nginx/sites-available/mc-panel
# Replace YOUR_DOMAIN with your actual domain (e.g. panel.example.com)
# After certbot runs, it auto-adds the SSL block below.

server {
    listen 80;
    server_name YOUR_DOMAIN;

    # All HTTP traffic → panel backend (serves built frontend + API)
    location / {
        proxy_pass         http://127.0.0.1:4000;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }

    # WebSocket — real-time console needs Upgrade header
    location /ws/ {
        proxy_pass         http://127.0.0.1:4000;
        proxy_http_version 1.1;
        proxy_set_header   Upgrade    $http_upgrade;
        proxy_set_header   Connection "upgrade";
        proxy_set_header   Host       $host;
        proxy_read_timeout 3600s;
    }
}

